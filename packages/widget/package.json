{
  "name": "@codepet/pal-widget",
  "version": "0.1.0-alpha.3",
  "description": "Portable React surfaces for Pal achievements, companion state, and rewards.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codepetca/pal.git",
    "directory": "packages/widget"
  },
  "homepage": "https://github.com/codepetca/pal/tree/main/packages/widget#readme",
  "bugs": {
    "url": "https://github.com/codepetca/pal/issues"
  },
  "keywords": [
    "achievements",
    "education",
    "pal",
    "react",
    "widget"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme-contract": {
      "types": "./dist/theme-contract.d.ts",
      "import": "./dist/theme-contract.js"
    },
    "./progression": {
      "types": "./dist/progression.d.ts",
      "import": "./dist/progression.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsup && node scripts/add-client-directive.mjs",
    "dev": "node scripts/clean-dist.mjs && tsup --watch --onSuccess \"node scripts/add-client-directive.mjs\"",
    "prepack": "pnpm run build",
    "prepublishOnly": "node scripts/assert-publish-tag.mjs",
    "release:alpha": "npm publish --access public --tag alpha",
    "verify:package": "node scripts/verify-package.mjs",
    "test": "node --import tsx --test src/**/*.test.ts src/**/*.test.tsx",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@pal/engine": "workspace:*",
    "@types/node": "^22.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-test-renderer": "^19",
    "eslint": "catalog:",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-test-renderer": "19.2.7",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
