{
  "name": "pal",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @codepet/pal-widget build && turbo dev",
    "sandbox:setup": "node scripts/setup-shared-sandbox.mjs",
    "sandbox:verify": "node --env-file=apps/web/.env.local scripts/verify-shared-sandbox.mjs",
    "build": "turbo build",
    "lint": "turbo lint",
    "test:discord-pr": "node --test scripts/notify-discord-pr.test.mjs",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20.12"
  },
  "packageManager": "pnpm@10.29.2"
}
