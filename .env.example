# Copy this file to apps/web/.env.local and fill in the values.
# (Next.js reads env files from apps/web/, not the repo root.)
# Never commit .env.local files to the repo.

# Database (Postgres). For local dev, start one with:
#   docker compose up -d postgres
# Must be a POOLED connection string — event ingest holds an interactive
# transaction with a row lock, which HTTP-based serverless drivers cannot do.
DATABASE_URL=postgres://pal:pal@localhost:5433/pal

# Database used by integration tests. Tests truncate tables between cases, so
# this must never point at a database whose contents you care about.
TEST_DATABASE_URL=postgres://pal:pal@localhost:5433/pal_test

# Distinct 32+ character integration credentials. Pika holds its value only on
# its backend; the sandbox proxy holds its own value only on Pal's backend.
PAL_INTEGRATION_SECRET=replace-with-a-long-random-pika-secret
SANDBOX_INTEGRATION_SECRET=replace-with-a-long-random-sandbox-secret

# Local sandbox source. "fixture" is the default and needs no database.
# Use "persisted" only to exercise the real event -> Postgres -> snapshot path
# on localhost. Vercel previews always force the in-memory fixture.
PAL_SANDBOX_MODE=fixture

# Separate 32+ character key used only to sign short-lived learner read tokens.
PAL_READ_TOKEN_SIGNING_SECRET=replace-with-a-long-random-signing-secret

# Exact browser origins allowed to call learner snapshot/reward APIs. Separate
# multiple production or preview origins with commas. HTTPS is required except
# for localhost development.
PAL_ALLOWED_WIDGET_ORIGINS=http://localhost:3001

# Optional fail-closed rollout boundary for guaranteed story sketches. Only
# calendar configurations persisted at or after this ISO timestamp participate;
# leave unset until the production cutover time is known.
PAL_STORY_SKETCH_REWARDS_EFFECTIVE_AT=
